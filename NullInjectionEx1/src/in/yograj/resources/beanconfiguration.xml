<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean class="in.yograj.beans.Customer" name="s1">
        <constructor-arg value="101"/>
        <constructor-arg value="Yograj"/>
        <constructor-arg ><null/></constructor-arg>
    </bean>

    <bean class="java.util.Date" name="d1">
        <property name="date" value="27"/>
        <property name="month" value="8"/>
        <property name="year" value="101"/>
    </bean>

    <bean class="in.yograj.beans.Customer" name="s2">
        <constructor-arg value="102"/>
        <constructor-arg value="Sachin"/>
        <constructor-arg ref="d1"/>
    </bean>

</beans>