<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
   <bean class="in.yograj.beans.AddNum" name="a1">
       <constructor-arg value="10"/>
       <constructor-arg value="30"/>
   </bean>

    <bean class="in.yograj.beans.AddNum" name="a2">
        <constructor-arg value="10" type="int"/>
        <constructor-arg value="30" type="int"/>
    </bean>


    <bean class="in.yograj.beans.AddNum" name="a3">
        <constructor-arg value="70" index="0"/>
        <constructor-arg value="80" index="1"/>
    </bean>

    <bean class="in.yograj.beans.AddNum" name="a4">
        <constructor-arg value="90" index="0"/>
        <constructor-arg value="100" index="1"/>
    </bean>


    <bean class="in.yograj.beans.AddNum" name="a5">
        <constructor-arg value="90" type="float" index="0"/>
        <constructor-arg value="100" index="1"/>
    </bean>



</beans>