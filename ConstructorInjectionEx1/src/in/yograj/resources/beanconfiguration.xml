<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean class="in.yograj.beans.Address" id="s1">
        <constructor-arg name="rollno" value="Yograj"/>
        <constructor-arg name="name" value="101"/>
    </bean>

    <bean name="s2" class="in.yograj.beans.Address">
        <constructor-arg value="Sachin" type="String"/>
        <constructor-arg value="102" type="int"/>
    </bean>

    <bean name="s3" class="in.yograj.beans.Address">
        <constructor-arg name="name" value="Vidur" type="String"/>
        <constructor-arg name="rollno" value="103" type="int"/>
    </bean>


</beans>