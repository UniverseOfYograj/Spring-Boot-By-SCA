<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <!-- bean definitions here -->
    <bean class="in.yograj.beans.Employee" name="emp1">
        <property name="empId" value="101"/>
        <property name="empName" value="Ajay"/>
    </bean>
    <bean class="in.yograj.beans.Employee" name="emp2">
        <property name="empId" value="102"/>
        <property name="empName" value="Deepak"/>
    </bean>
    <bean class="in.yograj.beans.Employee" name="emp3">
        <property name="empId" value="103"/>
        <property name="empName" value="Chetan"/>
    </bean>

    <bean class="in.yograj.beans.Company" name="">
        <property name="compName" value="Amazon"/>
        <property name="workers">
            <array>
               <ref bean="emp1"/>
                <ref bean="emp2"/>
                <ref bean="emp3"/>
            </array>
        </property>
    </bean>


</beans>